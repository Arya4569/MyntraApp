# Server Port (Render injects PORT automatically; defaults to 5000 locally)
PORT=5000

# Node Environment ('development' locally, 'production' on Render)
NODE_ENV=production

# JWT Authentication Secret (Generate a strong random 64-character secret for Render Dashboard)
JWT_SECRET=replace_with_a_secure_random_secret_in_render_dashboard

# JWT Token Duration
JWT_EXPIRES_IN=30d

# Allowed Frontend URL(s) for CORS (e.g., https://my-myntra-app.onrender.com or * to allow all clients)
CLIENT_URL=*

# Razorpay Real-Time Payment Gateway Configuration
# Get your Key ID and Key Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Fast2SMS OTP Gateway Configuration
FAST2SMS_API_KEY=your_fast2sms_api_key_optional

# Free Real-Time Email OTP via Gmail SMTP
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Expo Push Notifications
# (Optional) Expo Access Token for high-throughput authorized push delivery: https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=your_expo_access_token_optional
